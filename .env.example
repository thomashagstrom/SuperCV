# Durable store for accounts, sessions and resumes (Upstash Redis REST API).
# Required on hosts with a read-only deployment folder (e.g. Vercel). Create a
# Redis database at https://upstash.com and copy its REST URL and token.
# Both are read on every request, so setting them on the running service works.
# When either is unset, the local JSON file below is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, local development only. File used when no durable store above is set
# (JSON). When unset, ".data/store.json" under the working directory is used.
# The directory must be writable by the server process; the app creates it.
LOOMSHIFT_DATA_FILE=.data/store.json
