# Production: durable storage for accounts, sessions and resumes. A Redis-compatible
# REST store (Upstash Redis, or Vercel KV which sets these two names for you).
# When both are set they are used and nothing is written to disk. When either is
# unset the app falls back to the local JSON file below, which does not survive
# on read-only or ephemeral hosting. The hosting owner must create the database.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional, local development only. File used when no REST store is configured (JSON).
# When unset, ".data/store.json" under the working directory is used.
# The directory must be writable by the server process; the app creates it.
LOOMSHIFT_DATA_FILE=.data/store.json
